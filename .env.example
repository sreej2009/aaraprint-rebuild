# Catalogue API base URL (defaults to the static mock in public/api/v1)
VITE_API_BASE_URL=/api/v1
# Product media base URL (defaults to /media, served from the recovered folders in dev/preview)
VITE_MEDIA_BASE_URL=/media
# Public site origin for canonical and Open Graph URLs, e.g. https://www.aaraprint.in
VITE_SITE_URL=
# Local media folders for dev/preview (path-delimiter separated)
# AARAPRINT_MEDIA_ROOTS=../recovered-additional;../recovered
# Support and grievance email shown on the site (the original site only had a placeholder)
VITE_SUPPORT_EMAIL=
